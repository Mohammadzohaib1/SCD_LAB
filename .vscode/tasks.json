{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C++ program",
            "type": "process",
            "command": "clang++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-g",
                "${workspaceFolder}\\main.cpp",
                "-o",
                "${workspaceFolder}\\main.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Build main.cpp with LLVM Clang"
        }
    ]
}
